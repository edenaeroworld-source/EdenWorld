{
  "name": "edenworld",
  "version": "0.1.0",
  "private": true,
  "description": "EDENWORLD — Genesis 0.1. Mundo aberto 3D do universo Éden Aero para navegadores (TypeScript + Three.js + WebGL2).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/run.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
